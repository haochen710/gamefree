{
  "name": "xiantu-idle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "仙途 —— 一款修仙题材的网页放置（idle）游戏",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "simulate": "esbuild tools/simulate.ts --bundle --platform=node --format=esm --outfile=tools/.simulate.mjs --log-level=warning && node tools/.simulate.mjs",
    "smoke": "esbuild tools/smoke.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=tools/.smoke.cjs --log-level=warning && node tools/.smoke.cjs"
  },
  "dependencies": {
    "break_infinity.js": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
